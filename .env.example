STORMCLOUD_ENV=development
STORMCLOUD_NETWORK_NAME=stormcloud
POSTGRES_PASSWORD=change-me
STORMCLOUD_DATABASE_URL=postgresql+psycopg://stormcloud:change-me@postgres:5432/stormcloud
NATS_USER=stormcloud
NATS_PASSWORD=replace-with-a-random-password
STORMCLOUD_NATS_URL=nats://stormcloud:replace-with-a-random-password@nats:4222
STORMCLOUD_S3_ENDPOINT_URL=http://minio:9000
STORMCLOUD_S3_ACCESS_KEY=stormcloud
STORMCLOUD_S3_SECRET_KEY=change-me-object-store
STORMCLOUD_JWT_SECRET=change-me-at-least-32-random-characters
STORMCLOUD_CORS_ORIGINS=http://localhost:5173
STORMCLOUD_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,api
STORMCLOUD_PUBLIC_DOCS=true
STORMCLOUD_AUTH_RATE_LIMIT_PER_MINUTE=30
STORMCLOUD_INVITE_ACCEPT_URL=http://localhost:5173/accept-invite
STORMCLOUD_SMTP_HOST=mailpit
STORMCLOUD_SMTP_PORT=1025
STORMCLOUD_SMTP_FROM=stormcloud@localhost
STORMCLOUD_FETCHER_BASE_URL=http://source-extractor:8090
STORMCLOUD_FETCHER_TOKEN=replace-with-at-least-32-random-characters
STORMCLOUD_FETCHER_MAX_BYTES=10485760
STORMCLOUD_FETCHER_RAW_MAX_BYTES=8388608
STORMCLOUD_MODEL_GATEWAY_URL=http://model-gateway:8085
STORMCLOUD_MODEL_CONFIG_PATH=/app/config/models.yaml
STORMCLOUD_PROMPT_ROOT=/app/config/prompts
STORMCLOUD_MODEL_GATEWAY_FAKE=true
STORMCLOUD_DEBUG_RETURN_INVITE_TOKEN=true
STORMCLOUD_SIMILARITY_THRESHOLD=0.72
STORMCLOUD_SIMILARITY_TOP_K=20
STORMCLOUD_API_PORT=8080
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-running
